# Copy this file to .env and fill in what you need. All of this is optional --
# the app works with zero setup using Stooq (DATA_SOURCE=stooq, the default),
# which needs no API key.

# Which price data source to use: stooq (default), polygon, or alpaca.
DATA_SOURCE=stooq

# Polygon.io (only needed if DATA_SOURCE=polygon).
# Free key: https://polygon.io/dashboard/signup -- takes about 2 minutes.
# Free tier is end-of-day only, which is all this app needs.
POLYGON_API_KEY=

# Alpaca (only needed if DATA_SOURCE=alpaca).
# Free key pair: https://app.alpaca.markets/signup -- the free paper-trading
# account includes market data access.
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
